# MOJO landing: static export served from __BASE_PATH__/ on an Apache host (heylixir.com/mojo).
# The deploy workflow copies this to out/.htaccess, replacing __BASE_PATH__.
#
# This file's RewriteEngine replaces the parent site's rules for this directory, so the parent's
# "rewrite every unknown URL to index.html" fallback does NOT apply here: unknown URLs get a real
# 404, which search engines need (soft 404s hurt indexing).

Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 __BASE_PATH__/404.html

RewriteEngine On

# HTTPS and a single host, so every page has exactly one URL.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Generated social images have no file extension.
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>
AddType application/manifest+json .webmanifest
AddType text/plain .txt
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  # Hashed build assets never change; HTML must always revalidate.
  <If "%{REQUEST_URI} =~ m#/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
