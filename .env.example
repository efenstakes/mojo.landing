# MOJO website environment. All NEXT_PUBLIC_* values are built into the public site,
# so none of them are secrets. Production values live in .env.production.

# public URL, served at the domain root (a path here, e.g. https://example.com/mojo, becomes the basePath)
NEXT_PUBLIC_SITE_URL=https://mojo.heylixir.com
# MOJO API origin for the launch waitlist (the site adds /v1). Empty = the form emails the team.
NEXT_PUBLIC_MOJO_API_URL=
# countdown target (ISO 8601)
NEXT_PUBLIC_LAUNCH_DATE=2026-12-01T00:00:00Z
# store links; while both are empty the site shows the waitlist instead
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# analytics and search consoles (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_TWITTER_HANDLE=
